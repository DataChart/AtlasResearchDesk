---
import Base from '../../layouts/Base.astro';
import { getPosts, tagCounts } from '../../lib/content';
import { tagUrl } from '../../lib/paths';

const tags = tagCounts(await getPosts());
---
<Base title="Tags" description="Research posts by topic.">
  <h1>Tags</h1>
  {tags.length === 0 && <p class="empty">No tags yet.</p>}
  <ul class="tag-cloud">
    {tags.map(([t, n]) => (
      <li><a class="tag" href={tagUrl(t)}>{t} <span class="muted">{n}</span></a></li>
    ))}
  </ul>
</Base>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }
  .tag-cloud .tag {
    font-size: 0.9rem;
    padding: 0.25rem 0.7rem;
  }
</style>
