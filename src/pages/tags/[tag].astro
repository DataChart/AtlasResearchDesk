---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagCounts, type Post } from '../../lib/content';
import { url } from '../../lib/paths';

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagCounts(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;
---
<Base title={`Tagged “${tag}”`} description={`Research posts tagged ${tag}.`}>
  <p class="eyebrow"><a href={url('/tags/')}>Tags</a></p>
  <h1>{tag}</h1>
  <p class="lede">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
  <PostList posts={posts} />
</Base>
