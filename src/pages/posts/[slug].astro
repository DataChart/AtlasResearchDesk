---
import PostArticle from '../../components/PostArticle.astro';
import { getPosts, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = (await getPosts()).reverse(); // oldest first, so "next" is newer
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}
---
<PostArticle {...Astro.props} />
