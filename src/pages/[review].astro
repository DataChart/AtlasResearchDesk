---
// Month-end retrospective (type: retrospective), served at /retrospective/.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getReviews, type Review } from '../lib/content';
import { longDay } from '../lib/dates';

export async function getStaticPaths() {
  return (await getReviews())
    .filter((r) => r.data.type === 'retrospective')
    .map((review) => ({ params: { review: review.id }, props: { review } }));
}

interface Props {
  review: Review;
}
const { review } = Astro.props;
const { Content } = await render(review);
---
<Base title={review.data.title} description={review.data.dek} type="article">
  <article data-pagefind-body>
    <p class="eyebrow">Retrospective</p>
    <h1>{review.data.title}</h1>
    {review.data.dek && <p class="lede">{review.data.dek}</p>}
    <p class="meta-line"><time datetime={review.data.date.toISOString()}>{longDay(review.data.date)}</time></p>
    <div class="prose"><Content /></div>
  </article>
</Base>
