---
import type { Post } from '../lib/content';
import { readingTime } from '../lib/content';
import { isoDay } from '../lib/dates';
import { postUrl, tagUrl, cycleUrl } from '../lib/paths';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  posts: Post[];
  showCycle?: boolean;
}
const { posts, showCycle = true } = Astro.props;
---
<ul class="post-list">
  {posts.map((p) => (
    <li>
      <div class="meta-line">
        <time datetime={p.data.date.toISOString()}>{isoDay(p.data.date)}</time>
        {showCycle && <a href={cycleUrl(p.data.cycle)}>Cycle {p.data.cycle}</a>}
        <span>{readingTime(p)} min read</span>
        <VerdictBadge verdict={p.data.qa.verdict} sample={p.data.sample} />
      </div>
      <h3><a href={postUrl(p.id)}>{p.data.title}</a></h3>
      <p class="muted">{p.data.dek}</p>
      {p.data.tags.length > 0 && (
        <ul class="tag-list">
          {p.data.tags.map((t) => <li><a class="tag" href={tagUrl(t)}>{t}</a></li>)}
        </ul>
      )}
    </li>
  ))}
</ul>
