---
import { VERDICT_LABEL } from '../lib/content';
interface Props {
  verdict: string;
  sample?: boolean;
}
const { verdict, sample = false } = Astro.props;
---
<span class={`badge badge-${verdict}`} title="QA verdict">
  <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12"><path fill="currentColor" d="M6.2 11.6 2.6 8l1.1-1.1 2.5 2.5 6.1-6.1L13.4 4.4z" /></svg>
  QA: {VERDICT_LABEL[verdict] ?? verdict}
</span>
{sample && <span class="badge badge-sample">Sample</span>}
