---
import { VERDICT_LABEL, FAILED_VERDICTS } from '../lib/content';
interface Props {
  verdict: string;
  sample?: boolean;
}
const { verdict, sample = false } = Astro.props;
const failed = FAILED_VERDICTS.has(verdict);
---
<span class={`badge badge-${verdict}${failed ? ' badge-failed' : ''}`} title={failed ? 'QA verdict: this post failed QA' : 'QA verdict'}>
  {failed ? (
    <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12"><path fill="currentColor" d="M4.1 3 8 6.9 11.9 3 13 4.1 9.1 8 13 11.9 11.9 13 8 9.1 4.1 13 3 11.9 6.9 8 3 4.1z" /></svg>
  ) : (
    <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12"><path fill="currentColor" d="M6.2 11.6 2.6 8l1.1-1.1 2.5 2.5 6.1-6.1L13.4 4.4z" /></svg>
  )}
  QA: {VERDICT_LABEL[verdict] ?? verdict}
</span>
{sample && <span class="badge badge-sample">Sample</span>}
