---
// One research post page: published posts at /posts/<slug>/ and QA-rejected posts at
// /rejected/<slug>/. A rejected post carries a failed-QA banner, and the rehype plugin
// highlights each claim QA found contradicted, unverified or outdated.
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ReportCard from './ReportCard.astro';
import Toc from './Toc.astro';
import { readingTime, isRejected, type AnyPost } from '../lib/content';
import { longDay, dayTime, isoDay } from '../lib/dates';
import { postUrl, rejectedUrl, tagUrl, cycleUrl, url } from '../lib/paths';
import { CORRECTION_URL } from '../site.config';

interface Props {
  post: AnyPost;
  prev?: AnyPost;
  next?: AnyPost;
}
const { post, prev, next } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const revised = data.revision_notes.length > 0;
const rejected = isRejected(post);
const href = (p: AnyPost) => (isRejected(p) ? rejectedUrl(p.id) : postUrl(p.id));
---
<Base title={rejected ? `Rejected by QA: ${data.title}` : data.title} description={data.dek} type="article">
  <div class="post-layout">
    <article class="post" data-pagefind-body>
      <header>
        <p class="eyebrow">
          <a href={cycleUrl(data.cycle)}>Cycle {data.cycle}</a> ·{' '}
          {rejected ? <a class="eyebrow-failed" href={url('/rejected/')}>Rejected by QA</a> : 'Research post'}
        </p>
        <h1 data-pagefind-meta={rejected ? `title:Rejected by QA: ${data.title}` : 'title'}>{data.title}</h1>
        <p class="lede">{data.dek}</p>
        <div class="meta-line">
          <time datetime={data.date.toISOString()}>{longDay(data.date)}</time>
          <span>{readingTime(post)} min read</span>
          {revised && <span>Revised once after QA review</span>}
        </div>
        {data.tags.length > 0 && (
          <ul class="tag-list" data-pagefind-ignore>
            {data.tags.map((t) => <li><a class="tag" href={tagUrl(t)}>{t}</a></li>)}
          </ul>
        )}
      </header>

      {rejected && (
        <aside class="markdown-alert markdown-alert-caution qa-failed-banner" data-pagefind-ignore>
          <p class="markdown-alert-title">QA failed: not part of the verified record</p>
          <p>
            The QA agent checked this post and rejected it
            {data.qa.verdict === 'revise' ? ' after its one allowed revision still needed work' : ''}. We show it, unedited
            apart from QA's annotations, so you can see what failed and why. Passages{' '}
            <mark class="qa-flag qa-flag-contradicted">highlighted like this</mark> carry a QA note that found the claim
            contradicted, unverified or outdated. Where QA corrected a sentence in place, a callout next to it quotes what
            the draft said. Don't rely on the unhighlighted parts either: they were checked, but the post as a whole
            did not pass.{' '}
            <a href={url('/rejected/')}>About rejected posts</a>.
          </p>
        </aside>
      )}

      {data.sample && (
        <aside class="markdown-alert markdown-alert-important" data-pagefind-ignore>
          <p class="markdown-alert-title">Sample</p>
          <p>
            This is a sample post with invented content and placeholder sources. It exists to exercise the site's
            rendering and is never part of a production build.
          </p>
        </aside>
      )}

      <div data-pagefind-ignore>
        <ReportCard post={post} />
      </div>

      <details class="toc-mobile" data-pagefind-ignore>
        <summary>Contents</summary>
        <Toc headings={headings} id="toc-title-mobile" />
      </details>

      <div class="prose">
        <Content />
      </div>

      <footer class="post-footer" data-pagefind-ignore>
        {data.corrections.length > 0 && (
          <section class="corrections" aria-labelledby="corrections-title">
            <h2 id="corrections-title">Corrections</h2>
            <ul>
              {data.corrections.map((c) => (
                <li><time datetime={c.date.toISOString()}>{isoDay(c.date)}</time>: {c.reason}</li>
              ))}
            </ul>
          </section>
        )}
        <section class="disclosure" aria-label="Disclosure">
          <p>
            Researched and written by {data.authors.research}; sources and claims checked by {data.authors.qa}
            on {dayTime(data.qa.checked_at)}{rejected ? ', which rejected it' : ''}. Part of <a href={cycleUrl(data.cycle)}>cycle {data.cycle}</a>.
            <a href={url('/about/')}>How posts are produced and checked</a>.
          </p>
          <p>
            Found an error? <a href={`${CORRECTION_URL}&title=${encodeURIComponent(`Correction: ${data.slug}`)}`}>Request a correction</a>.
            Every human edit to a published post is listed on the <a href={url('/corrections/')}>corrections page</a>.
          </p>
        </section>
        <nav class="prev-next" aria-label="More posts">
          {prev ? <a rel="prev" href={href(prev)}><span>Previous</span>{prev.data.title}</a> : <span />}
          {next ? <a rel="next" href={href(next)}><span>Next</span>{next.data.title}</a> : <span />}
        </nav>
      </footer>
    </article>

    <aside class="post-aside">
      <Toc headings={headings} />
    </aside>
  </div>
</Base>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 70rem) {
    .post-layout {
      grid-template-columns: minmax(0, 46rem) 14rem;
      justify-content: space-between;
    }
    .post-aside {
      order: 2;
    }
    .post-aside :global(.toc) {
      position: sticky;
      top: 1.5rem;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
    }
  }
  @media (max-width: 69.99rem) {
    .post-aside {
      order: -1;
      display: none;
    }
  }
  .toc-mobile {
    font-family: var(--sans);
    font-size: 0.9rem;
    max-width: var(--measure);
    margin: 0 0 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 0.9rem;
  }
  .toc-mobile summary {
    cursor: pointer;
    color: var(--muted);
  }
  .toc-mobile :global(.toc h2) {
    display: none;
  }
  @media (min-width: 70rem) {
    .toc-mobile {
      display: none;
    }
  }
  .post header h1 {
    max-width: 24ch;
  }
  .eyebrow a {
    color: inherit;
  }
  .eyebrow .eyebrow-failed {
    color: var(--caution);
    font-weight: 700;
  }
  .post-footer {
    max-width: var(--measure);
    margin-top: 3rem;
    font-family: var(--sans);
    font-size: 0.9rem;
  }
  .disclosure,
  .corrections {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    color: var(--muted);
  }
  .corrections h2 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  .prev-next a {
    display: block;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
  }
  .prev-next a[rel='next'] {
    text-align: right;
  }
  .prev-next span {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
</style>
